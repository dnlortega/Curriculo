generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AccessLog {
  id        String   @id @default(cuid())
  ip        String?
  country   String?
  city      String?
  device    String?
  os        String?
  browser   String?
  photoUrl  String?
  createdAt DateTime @default(now())
}
